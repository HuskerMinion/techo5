#!/bin/busybox sh
# Skylight installer initramfs: install-skylight.py writes this image into recovery for one boot and
# starts it with Android's `reboot recovery`. It runs install.sh (tools/linux/skylight/install) on the
# set staged in /cache/techo5-install, with nothing else of the eMMC mounted, then:
#
#   - done:   reboots; misc says boot-recovery, so the stock U-Boot starts TECHO5 from recovery
#   - stopped before writing anything: reboots into stock Android, which is as it was
#   - stopped after writing began: stays here, with what happened on the screen and a root shell on
#     the micro-USB port (USB serial), and never reboots by itself
#
# The outcome goes into /cache/techo5-install/status (done, failed N) and install.log, which
# install-skylight.py reads from Android when the unit comes back there. It runs the set only when
# status says staged (the host's confirmed install), or once more after a run that never finished
# (power lost: status still "running 1").
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /tmp /cache /sys/kernel/config
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /tmp
export INSTALL_TTY=/dev/tty0
S=/cache/techo5-install

show() {
	echo "$*" > /dev/tty0 2>/dev/null
	echo "skylight-installer: $*" > /dev/kmsg
}
part() {
	for u in /sys/class/block/mmcblk*p*/uevent; do
		grep -qx "PARTNAME=$1" "$u" 2>/dev/null && { echo "/dev/$(basename "$(dirname "$u")")"; return 0; }
	done
	return 1
}
reboot_now() { sync; sleep 5; /bin/reboot-normal; sleep 30; reboot -f; }

# Stay up: the reason on the screen, a root shell on USB serial (USB serial number techo5-installer,
# so install-skylight.py can tell it from TECHO5's own console). Never returns.
stay() {
	show ""
	show "TECHO5 installer: $*"
	show "Leave the unit plugged in. See docs/install-skylight.md, \"If the install stops\"."
	G=/sys/kernel/config/usb_gadget/sky
	if mkdir -p $G 2>/dev/null; then
		echo 0x1d6b > $G/idVendor
		echo 0x0104 > $G/idProduct
		mkdir -p $G/strings/0x409 $G/functions/acm.usb0 $G/configs/c.1/strings/0x409
		echo "Skylight installer" > $G/strings/0x409/product
		echo "TECHO5" > $G/strings/0x409/manufacturer
		echo "techo5-installer" > $G/strings/0x409/serialnumber
		echo "acm" > $G/configs/c.1/strings/0x409/configuration
		ln -s $G/functions/acm.usb0 $G/configs/c.1/ 2>/dev/null
		UDC=$(ls /sys/class/udc | head -1)
		[ -n "$UDC" ] && echo "$UDC" > $G/UDC
	fi
	(
		while true; do
			[ -e /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
			sleep 1
		done
	) &
	while true; do sleep 3600; done
}

show "TECHO5 installer starting"
for i in $(seq 1 20); do part misc >/dev/null && part cache >/dev/null && break; sleep 0.5; done
MISC=$(part misc) || stay "no misc partition"
CACHE=$(part cache) || stay "no cache partition"

# Android's "reboot recovery" left "boot-recovery" at the start of misc, which would bring this image
# back on every boot. Back to the zeros stock Android keeps there, so that anything that stops here
# before the install is done restarts into Android. install.sh writes boot-recovery again, last.
if [ "$(dd if=$MISC bs=13 count=1 2>/dev/null)" = "boot-recovery" ]; then
	dd if=/dev/zero of=$MISC bs=2048 count=1 conv=notrunc,fsync 2>/dev/null && sync
fi

mount -t ext4 -o noatime $CACHE /cache || stay "Android's cache partition would not mount"
status=$(cat $S/status 2>/dev/null)
case "$status" in
staged) attempt=1 ;;
"running 1") attempt=2; show "The last install never finished (power lost?); running it once more." ;;
*)
	umount /cache
	if part userdata >/dev/null; then
		show "Nothing to install (status: ${status:-none}); restarting into Android."
		reboot_now
	fi
	stay "nothing to install (status: ${status:-none}), and Android's userdata is gone"
	;;
esac

# The set into RAM, so that nothing of the eMMC is mounted while it is written.
mkdir -p /tmp/set/firmware
cp $S/install.conf $S/SHA256SUMS $S/gpt-primary.bin $S/gpt-backup.bin $S/store.img.gz $S/boot.img /tmp/set/ &&
	cp $S/firmware/* /tmp/set/firmware/ || { umount /cache; stay "the staged set could not be read"; }
[ -d $S/settings ] && { mkdir -p /tmp/set/settings && cp $S/settings/* /tmp/set/settings/; }
cp /installer/data.img.gz /installer/data.img.info /tmp/set/
echo "running $attempt" > $S/status
sync
umount /cache || stay "Android's cache partition would not unmount"

show "Installing TECHO5. Do not unplug the unit."
INSTALL_ATTEMPT=$attempt sh /installer/install.sh /tmp/set > /tmp/install.log 2>&1
rc=$?
last=$(grep 'install: ' /tmp/install.log | tail -1 | sed 's/^install: //')

# The outcome, for install-skylight.py; the staged settings (the Home Assistant key) are removed.
if mount -t ext4 -o noatime $CACHE /cache; then
	cp /tmp/install.log $S/install.log
	rm -rf $S/settings
	if [ $rc = 0 ]; then echo done > $S/status; else echo "failed $rc" > $S/status; fi
	sync
	umount /cache
fi
case $rc in
0)
	show "TECHO5 is installed. Restarting into it."
	reboot_now
	;;
2)
	show "The install stopped before writing anything: $last"
	show "Restarting into Android, which is as it was."
	reboot_now
	;;
*)
	stay "the install stopped partway: $last"
	;;
esac
