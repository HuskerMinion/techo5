@@ -126,6 +126,39 @@ cont_splash_mem: cont-splash@90001000 {
 		};
 	};
 
+	/*
+	 * The front camera module's analog and digital rails come from PMIC
+	 * LDOs through load switches enabled by TLMM GPIOs (named CAM_VANA
+	 * and CAM_VDIG in the stock firmware).
+	 */
+	cam_vana: cam-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vana";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+
+		gpio = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l17>;
+
+		pinctrl-0 = <&cam_vana_en_default>;
+		pinctrl-names = "default";
+	};
+
+	cam_vdig: cam-vdig-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vdig";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+
+		gpio = <&tlmm 118 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l2>;
+
+		pinctrl-0 = <&cam_vdig_en_default>;
+		pinctrl-names = "default";
+	};
+
 	panel_avdd: panel-avdd-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "panel_avdd";
@@ -175,6 +208,67 @@ wlan_pwrseq: wlan-sdio-pwrseq {
 	};
 };
 
+&camss {
+	vdda-supply = <&pm8953_s3>;
+
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+
+			/* CSIPHY0 lanes 0 and 1; lane 7 is the clock lane */
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	pinctrl-0 = <&cci0_default &cci1_default &camss_mclk0_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&cci_i2c0 {
+	camera@37 {
+		compatible = "samsung,s5kc505a";
+		reg = <0x37>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_front_default>;
+		pinctrl-names = "default";
+
+		vdda-supply = <&cam_vana>;
+		vddd-supply = <&cam_vdig>;
+		vddio-supply = <&pm8953_l6>;
+
+		orientation = <0>; /* front facing */
+		/*
+		 * With the unit standing as the display is used, the sensor's
+		 * read-out is upside down.
+		 */
+		rotation = <180>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <480000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
 &gpu_zap_shader {
 	firmware-name = "qcom/msm8953/lenovo/cd-18781y/a506_zap.mdt";
 };
