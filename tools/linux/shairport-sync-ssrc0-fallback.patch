+// Local patch: SSRC-0 senders (Music Assistant's cliairplay) put a standard 16-bit RTP
+// sequence number in bytes 2-3 and the payload type (103) in byte 1, and send 16-bit
+// flushUntilSeq values. Apple senders use a 23-bit sequence number. Compare in the
+// sender's own space so that FLUSHBUFFERED can complete.
+static int32_t seq_diff(uint32_t a, uint32_t b, int sixteen_bit) {
+  if (sixteen_bit)
+    return (int16_t)((a - b) & 0xFFFF);
+  return a_minus_b_mod23(a, b);
+}
