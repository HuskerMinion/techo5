diff --git a/include/misc/gating.h b/include/misc/gating.h
index deb730035c24..ec9eb6825668 100644
--- a/include/misc/gating.h
+++ b/include/misc/gating.h
@@ -25,9 +25,10 @@ enum gating_state {
 /* register a srcu notifier call by providing a notifier block */
 int register_gating_state_notifier(struct notifier_block *nb);
 
-/* the latch as the hardware reports it now: GATED, UNGATED, or -ENODEV before the driver is up.
- * Reading the pin is the only truth available to another driver: the notifier says what changed,
- * and a change that is missed is never repeated.
+/* the latch as the hardware reports it now: GATED (also while a mute is being turned on), UNGATED,
+ * -ENODEV before the driver is up, or another negative error when the pin cannot be read. Only
+ * UNGATED means the latch is released. Reading the pin is the only truth available to another
+ * driver: the notifier says what changed, and a change that is missed is never repeated.
  */
 int gating_hw_state(void);
 
