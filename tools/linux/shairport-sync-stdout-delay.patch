 #include <memory.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <sys/ioctl.h>
+#include <time.h>
 #include <unistd.h>
 
 static int fd = STDOUT_FILENO;
 static int warned = 0;
 static unsigned int bytes_per_frame = 0;
+static unsigned int frame_rate = 0;
+
+// With SPS_STDOUT_DELAY_FILE set, the program reading standard output says in that file how much of what it
+// has read is still to be heard: two numbers, the nanoseconds still pending and the CLOCK_REALTIME
+// nanosecond that was true at, rewritten as it takes more. Without it there is no delay(), as before.
+static const char *delay_file = NULL;
+
+// delay is what has been written and not yet heard, in frames: what waits unread in the pipe, and what the
+// reader last said it holds, less the time since it said so, since that plays on meanwhile.
+static int delay(long *the_delay) {
+  if (delay_file == NULL || frame_rate == 0 || bytes_per_frame == 0)
+    return -ENODEV;
+  int unread = 0;
+  if (ioctl(fd, FIONREAD, &unread) != 0 || unread < 0)
+    unread = 0;
+  long long pending = 0, at = 0;
+  int dfd = open(delay_file, O_RDONLY);
+  if (dfd >= 0) {
+    char b[64];
+    ssize_t n = pread(dfd, b, sizeof(b) - 1, 0);
+    close(dfd);
+    if (n > 0) {
+      b[n] = 0;
+      if (sscanf(b, "%lld %lld", &pending, &at) != 2)
+        pending = 0, at = 0;
+    }
+  }
+  if (at > 0) {
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    long long now = (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+    pending -= now - at;
+  }
+  if (pending < 0)
+    pending = 0;
+  *the_delay = unread / (int)bytes_per_frame + (long)(pending * frame_rate / 1000000000LL);
+  return 0;
+}
 
