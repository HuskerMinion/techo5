# TECHO5's values for u-boot-amazon-echo's Echo Show 8 2nd gen board (amazon_athena_defconfig),
# applied by build.sh on top of the board's defconfig. Kconfig fragment lines, as in .config; the
# build stops if one does not hold in the final .config.
#
# The marker every TECHO5 athena U-Boot carries: U-Boot never boots an image holding it, and echod's
# kernel update (echod/internal/update/kernel/uboot.go) and tools/install-athena.py recognise
# TECHO5's U-Boot in the boot partition by it, and never write a kernel over it.
CONFIG_AB_SELF_MARKER="techo5-athena-uboot-image"
# The unit's amp tuning (the techo5,dsp-config slot, tools/linux/athena/kernel/dsp_slot.py) is in the
# device tree of U-Boot's own boot image, filled in by the installer, so LK's tree holds it but it is
# no addition of LK's. Carried into each slot's device tree, whose own slot is empty as released.
CONFIG_AB_DT_CARRY="techo5,dsp-config"
# Diagnostics: a note per boot stage and U-Boot's console output, in unused blocks of misc, readable
# after a reset (u-boot-amazon-echo SPEC.md, "Diagnostics").
CONFIG_AB_CRUMBS=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000
# No wait for a key on the serial console before abboot: the menu on screen is the only pause.
CONFIG_BOOTDELAY=0
