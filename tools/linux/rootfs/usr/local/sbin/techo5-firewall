#!/bin/sh
# techo5-firewall: on Wi-Fi, nothing reaches the device from the network except what it serves. Run by
# boot.sh before the network comes up; safe to run again.
#
# In on wlan0: Home Assistant's API (6053/tcp), mDNS (5353/udp), SSH (22/tcp; dropbear listens only
# while the SSH switch is on and a key is set), Sendspin audio (8928/tcp), the setup page and the camera
# and screen views (8181/tcp; each served only while it is on), AirPlay (5000/tcp, 6001-6010/udp) and
# Spotify Connect (4070/tcp), the camera over RTSP (8554/tcp), WS-Discovery's searches for it (3702/udp,
# feature/camstream) and DLNA's SSDP searches (1900/udp, IPv4), and AirPlay 2 (7000/tcp, 319-320/udp, and
# its senders' own ports, from a chain of its own below),
# which nothing listens on unless their switches are on; DHCP replies, ping,
# IPv6 neighbor discovery, and anything answering a connection the device made (calls included).
# Out: everything, as before.
#
# Only wlan0 is filtered, from a chain of its own: loopback and any other interface are left as they
# were, and so are rules anything else keeps. Rescue mode (tools/linux/init) runs none of this, on
# purpose: it is what a unit falls back to, and must stay reachable whatever went wrong.
#
# The kernel has iptables but not nftables, so the legacy tools are the ones that work. A rule that
# fails leaves the chain empty, which is open, rather than a device nobody can reach.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

command -v iptables-legacy > /dev/null || { echo "techo5-firewall: no iptables-legacy in this image" >&2; exit 0; }

CHAIN=TECHO5-IN
ok=1
# What an earlier run said about AirPlay 2 holds no longer: said again below if it still holds.
rm -f /run/techo5-no-airplay2
for T in iptables-legacy ip6tables-legacy; do
	$T -N $CHAIN 2> /dev/null
	$T -F $CHAIN || { ok=; continue; }
	$T -C INPUT -i wlan0 -j $CHAIN 2> /dev/null || $T -I INPUT -i wlan0 -j $CHAIN || { ok=; continue; }
	if ! {
		$T -A $CHAIN -m state --state ESTABLISHED,RELATED -j ACCEPT &&
		$T -A $CHAIN -p tcp --dport 6053 -j ACCEPT &&
		$T -A $CHAIN -p udp --dport 5353 -j ACCEPT &&
		$T -A $CHAIN -p tcp --dport 22 -j ACCEPT &&
		$T -A $CHAIN -p tcp --dport 8928 -j ACCEPT &&
		$T -A $CHAIN -p tcp --dport 8181 -j ACCEPT &&
		$T -A $CHAIN -p udp --dport 3702 -j ACCEPT &&
		# feature/streaming pins these (airplay.go, spotify.go).
		$T -A $CHAIN -p tcp --dport 5000 -j ACCEPT &&
		$T -A $CHAIN -p udp --dport 6001:6010 -j ACCEPT &&
		$T -A $CHAIN -p tcp --dport 4070 -j ACCEPT &&
		# feature/camstream, with a password, while its switch is on.
		$T -A $CHAIN -p tcp --dport 8554 -j ACCEPT
	}; then
		$T -F $CHAIN
		ok=
	fi
done
if [ -n "$ok" ]; then
	# feature/dlna: SSDP searches, IPv4 only, as SSDP listens (its HTTP side is on 8181).
	iptables-legacy -A $CHAIN -p udp --dport 1900 -j ACCEPT &&
		iptables-legacy -A $CHAIN -p udp --sport 67 --dport 68 -j ACCEPT &&
		iptables-legacy -A $CHAIN -p icmp -j ACCEPT &&
		ip6tables-legacy -A $CHAIN -p ipv6-icmp -j ACCEPT &&
		ip6tables-legacy -A $CHAIN -p udp --sport 547 --dport 546 -j ACCEPT &&
		iptables-legacy -A $CHAIN -j DROP &&
		ip6tables-legacy -A $CHAIN -j DROP || ok=
fi
if [ -z "$ok" ]; then
	# Open rather than half shut: both chains emptied.
	iptables-legacy -F $CHAIN 2> /dev/null
	ip6tables-legacy -F $CHAIN 2> /dev/null
	echo "techo5-firewall: a rule failed; Wi-Fi left open" >&2
	exit 1
fi
echo "techo5-firewall: Wi-Fi inbound closed except 6053, 5353, 22, 8928, 8181, 5000, 6001-6010, 4070, 8554, 3702" >&2

# AirPlay 2 (feature/streaming), where the image carries its receiver: its session (7000/tcp), nqptp's PTP
# (319-320/udp), and the event, data and audio ports the receiver opens for each session, which the kernel
# picks, from a sender seen on 7000 within ten minutes. Every packet to 7000 marks its sender, so one playing
# for hours stays marked: the first thing TECHO5-IN does, before what is already established is taken in.
# A chain of its own, made after TECHO5-IN is whole: it needs the kernel's recent match, and where a rule of
# it fails, the chain goes, Wi-Fi stays closed as above, and /run/techo5-no-airplay2 tells the daemon to keep
# the classic receiver.
APCHAIN=TECHO5-AP2
for T in iptables-legacy ip6tables-legacy; do
	$T -D $CHAIN -j $APCHAIN 2> /dev/null
	$T -F $APCHAIN 2> /dev/null
	$T -X $APCHAIN 2> /dev/null
done
if [ -x /usr/local/bin/techo5-shairport-sync ] && [ -x /usr/local/bin/techo5-nqptp ]; then
	apok=1
	for T in iptables-legacy ip6tables-legacy; do
		$T -N $APCHAIN &&
			$T -A $APCHAIN -p tcp --dport 7000 -m recent --name AIRPLAY --set &&
			$T -A $APCHAIN -p tcp --dport 7000 -j ACCEPT &&
			$T -A $APCHAIN -p udp --dport 319:320 -j ACCEPT &&
			$T -A $APCHAIN -p tcp --dport 1024:65535 -m recent --name AIRPLAY --rcheck --seconds 600 -j ACCEPT &&
			$T -A $APCHAIN -p udp --dport 1024:65535 -m recent --name AIRPLAY --rcheck --seconds 600 -j ACCEPT &&
			$T -I $CHAIN 1 -j $APCHAIN || apok=
	done
	if [ -n "$apok" ]; then
		echo "techo5-firewall: AirPlay 2 in on Wi-Fi: 7000, 319-320/udp and its senders' ports" >&2
	else
		for T in iptables-legacy ip6tables-legacy; do
			$T -D $CHAIN -j $APCHAIN 2> /dev/null
			$T -F $APCHAIN 2> /dev/null
			$T -X $APCHAIN 2> /dev/null
		done
		: > /run/techo5-no-airplay2
		echo "techo5-firewall: AirPlay 2's rules failed (no recent match in this kernel?); AirPlay stays classic" >&2
	fi
fi

# The tailnet (feature/tailscale, docs/tailscale.md), on the interface tailscaled is started with: Home
# Assistant's API (6053/tcp), the web port (8181/tcp, which serves the tailnet nothing but the setup page
# while Remote setup is on), SSH (22/tcp, while its switch is on), ping, and anything answering a
# connection the device made. Nothing else: not the music receivers, the camera stream or announcements,
# which are this house's. By the interface, not by address, so a house numbered in the tailnet's own
# range (100.64.0.0/10) changes nothing. Made before tailscaled runs: a rule names an interface that
# need not exist yet. A rule that fails leaves this chain empty too, and says so.
TSCHAIN=TECHO5-TS
tsok=1
for T in iptables-legacy ip6tables-legacy; do
	$T -N $TSCHAIN 2> /dev/null
	$T -F $TSCHAIN || { tsok=; continue; }
	$T -C INPUT -i tailscale0 -j $TSCHAIN 2> /dev/null || $T -I INPUT -i tailscale0 -j $TSCHAIN || { tsok=; continue; }
	if ! {
		$T -A $TSCHAIN -m state --state ESTABLISHED,RELATED -j ACCEPT &&
		$T -A $TSCHAIN -p tcp --dport 6053 -j ACCEPT &&
		$T -A $TSCHAIN -p tcp --dport 8181 -j ACCEPT &&
		$T -A $TSCHAIN -p tcp --dport 22 -j ACCEPT
	}; then
		$T -F $TSCHAIN
		tsok=
	fi
done
if [ -n "$tsok" ]; then
	iptables-legacy -A $TSCHAIN -p icmp -j ACCEPT &&
		ip6tables-legacy -A $TSCHAIN -p ipv6-icmp -j ACCEPT &&
		iptables-legacy -A $TSCHAIN -j DROP &&
		ip6tables-legacy -A $TSCHAIN -j DROP || tsok=
fi
if [ -z "$tsok" ]; then
	iptables-legacy -F $TSCHAIN 2> /dev/null
	ip6tables-legacy -F $TSCHAIN 2> /dev/null
	echo "techo5-firewall: a tailnet rule failed; the tailnet left open" >&2
else
	echo "techo5-firewall: tailnet inbound closed except 6053, 8181, 22" >&2
fi

# The video decoder (feature/video, as techo5-video): out to anywhere but the device itself. It follows
# names and redirects on its own, so this is where a name for 127.0.0.1 or a redirect to the device's
# own address is refused (loopback carries both), and link-local with it. The daemon makes the same
# chain for whichever user it runs the decoder as, and starts no decoder without it.
#
# Run again, it never leaves the decoder unfenced for a moment, whatever an earlier run left behind:
#  1. TECHO5-VIDEO is made whole where it is (each rule and the jump to it added if missing), so the
#     user is fenced from here on;
#  2. a TECHO5-VIDEO-NEW left by a run that stopped partway is taken out, jumps and all;
#  3. the rules are made afresh in TECHO5-VIDEO-NEW, its jump goes in, and only then does the old chain
#     come out and the new one take its name. Stopped partway, the next run starts again from 1.
uid=$(sed -n 's/^techo5-video:[^:]*:\([0-9]*\):.*/\1/p' /etc/passwd)
video_rules() {
	echo "-o lo -p tcp -j REJECT --reject-with tcp-reset"
	echo "-o lo -j REJECT"
	echo "-d $1 -j REJECT"
	echo "-d $2 -j REJECT"
}
if [ -n "$uid" ]; then
	fenced=1
	for T in iptables-legacy ip6tables-legacy; do
		lo4=127.0.0.0/8; ll=169.254.0.0/16
		[ $T = ip6tables-legacy ] && { lo4=::1/128; ll=fe80::/10; }
		jump="-m owner --uid-owner $uid -j"
		# 1. The fence as it stands, whole.
		$T -w -N TECHO5-VIDEO 2> /dev/null
		video_rules $lo4 $ll | while read -r rule; do
			$T -w -C TECHO5-VIDEO $rule 2> /dev/null || $T -w -A TECHO5-VIDEO $rule
		done
		$T -w -C OUTPUT $jump TECHO5-VIDEO 2> /dev/null || $T -w -I OUTPUT 1 $jump TECHO5-VIDEO
		# 2. What an earlier run left.
		while $T -w -D OUTPUT $jump TECHO5-VIDEO-NEW 2> /dev/null; do :; done
		$T -w -F TECHO5-VIDEO-NEW 2> /dev/null; $T -w -X TECHO5-VIDEO-NEW 2> /dev/null
		# 3. Made afresh, then swapped in.
		ok=1
		$T -w -N TECHO5-VIDEO-NEW || ok=
		[ -n "$ok" ] && video_rules $lo4 $ll | {
			r=0
			while read -r rule; do $T -w -A TECHO5-VIDEO-NEW $rule || r=1; done
			exit $r
		} || ok=
		[ -n "$ok" ] && $T -w -I OUTPUT 1 $jump TECHO5-VIDEO-NEW || ok=
		if [ -n "$ok" ]; then
			while $T -w -D OUTPUT $jump TECHO5-VIDEO 2> /dev/null; do :; done
			$T -w -F TECHO5-VIDEO && $T -w -X TECHO5-VIDEO && $T -w -E TECHO5-VIDEO-NEW TECHO5-VIDEO
		fi
		# Fenced is a jump from OUTPUT to one of the two, with its rules in it.
		$T -w -C OUTPUT $jump TECHO5-VIDEO 2> /dev/null && $T -w -C TECHO5-VIDEO -o lo -j REJECT 2> /dev/null ||
			$T -w -C OUTPUT $jump TECHO5-VIDEO-NEW 2> /dev/null || fenced=
	done
	if [ -n "$fenced" ]; then
		echo "techo5-firewall: the video decoder (uid $uid) kept off the device" >&2
	else
		echo "techo5-firewall: the video decoder could not be fenced here; the daemon keeps it off the device itself" >&2
	fi
fi
