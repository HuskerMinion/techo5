+	MUX_DIV_GATE_FLAGS(_id, _name, apll_div_parents, AUDIO_CLK_AUDDIV_0,	\
+		_mux_shift, 1 /* mux_width */, AUDIO_CLK_AUDDIV_1,	\
+		_div_shift, 8 /* div_width */, AUDIO_CLK_AUDDIV_0,	\
+		_gate_shift, 0)
