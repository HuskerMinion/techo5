+#define AUD_DIV_GATE(_id, _name, _parent, _div_shift, _gate_shift)	\
+	DIV_GATE(_id, _name, _parent, AUDIO_CLK_AUDDIV_0, _gate_shift,	\
+		 AUDIO_CLK_AUDDIV_0, 3 /* div_width */, _div_shift)
+
